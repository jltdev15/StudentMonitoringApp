rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return signedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isStudent() {
      return signedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function ownsClass(classId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function isOwnStudentRecord(studentId) {
      return isStudent()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == studentId
          || resource.data.userId == request.auth.uid
        );
    }

    function isClaimableStudentRecord() {
      return resource.data.status == 'active'
        && (resource.data.userId == null || resource.data.userId == '');
    }

    function isStudentClaimUpdate(studentId) {
      return isStudent()
        && (resource.data.userId == null || resource.data.userId == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'email', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid;
    }

    function isStudentProfileUpdate(studentId) {
      return isOwnStudentRecord(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contactNumber',
          'dateOfBirth',
          'gender',
          'guardianName',
          'guardianContact',
          'photoUrl',
          'updatedAt'
        ]);
    }

    function isValidClaimedStudentProfile(userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active';
    }

    function studentBelongsToClass(studentId, classId) {
      return exists(/databases/$(database)/documents/students/$(studentId))
        && classId in get(/databases/$(database)/documents/students/$(studentId)).data.classIds;
    }

    function requestClassOwnedByTeacher() {
      return isTeacher() && request.resource.data.teacherId == request.auth.uid;
    }

    function activityForSubmission() {
      return get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data;
    }

    function isStudentImageSubmission() {
      return isStudent()
        && request.resource.data.studentId == currentUser().studentId
        && request.resource.data.classId == activityForSubmission().classId
        && activityForSubmission().status == 'active'
        && activityForSubmission().acceptsImageAttachments == true
        && activityForSubmission().get('activityCategory', 'peta') != 'quiz'
        && studentBelongsToClass(currentUser().studentId, request.resource.data.classId)
        && exists(/databases/$(database)/documents/students/$(currentUser().studentId))
        && get(/databases/$(database)/documents/students/$(currentUser().studentId)).data.status == 'active'
        && get(/databases/$(database)/documents/students/$(currentUser().studentId)).data.userId == request.auth.uid
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() > 0
        && request.resource.data.attachments.size() <= 5
        && request.resource.data.status in ['submitted', 'late'];
    }

    function isStudentQuizSubmission() {
      return isStudent()
        && (
          request.resource.data.studentId == currentUser().studentId
          || (exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
              && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.userId == request.auth.uid)
        )
        && request.resource.data.classId == activityForSubmission().classId
        && activityForSubmission().status == 'active'
        && (activityForSubmission().activityCategory == 'quiz' || activityForSubmission().quizData != null)
        && request.resource.data.status in ['submitted', 'late'];
    }

    function isMissingQuizSubmissionTransition() {
      return resource.data.status == 'missing'
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.studentId == resource.data.studentId
        && isStudentQuizSubmission()
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'score',
          'answers',
          'remarks',
          'submittedAt',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        userId == request.auth.uid
        || isTeacher()
        || resource.data.email == request.auth.token.email
      );
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentNumber == resource.data.studentNumber
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.classIds == resource.data.classIds
        && request.resource.data.status == resource.data.status;
      allow delete: if signedIn()
        && resource.data.email == request.auth.token.email;
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if requestClassOwnedByTeacher();
      allow update: if isTeacher()
        && (
          // Normal update: teacher owns the class
          (resource.data.teacherId == request.auth.uid
            && request.resource.data.teacherId == request.auth.uid)
          // Migration update: teacher is claiming classes from old UID
          || request.resource.data.teacherId == request.auth.uid
        );
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if isTeacher() 
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isClaimableStudentRecord();
      allow create: if isTeacher();
      allow update: if isTeacher()
        || isStudentClaimUpdate(studentId)
        || isStudentProfileUpdate(studentId);
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isTeacher() 
        || (signedIn() && resource.data.studentId == currentUser().studentId);
      allow create, update: if ownsClass(request.resource.data.classId);
      allow delete: if ownsClass(resource.data.classId);
    }

    match /attendanceSessions/{sessionId} {
      allow read: if isTeacher() && ownsClass(resource.data.classId);
      allow create, update: if ownsClass(request.resource.data.classId);
      allow delete: if ownsClass(resource.data.classId);
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow create, update: if ownsClass(request.resource.data.classId);
      allow delete: if ownsClass(resource.data.classId);
    }

    match /activitySubmissions/{submissionId} {
      allow read: if (isTeacher() && ownsClass(resource.data.classId))
        || (isStudent()
          && resource.data.studentId == currentUser().studentId
          && studentBelongsToClass(currentUser().studentId, resource.data.classId))
        || (isStudent()
          && exists(/databases/$(database)/documents/students/$(resource.data.studentId))
          && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.userId == request.auth.uid
          && studentBelongsToClass(currentUser().studentId, resource.data.classId));
      allow create: if ownsClass(request.resource.data.classId)
        || (
          isStudentImageSubmission()
          && request.resource.data.score == null
          && request.resource.data.remarks == ''
          && request.resource.data.checkedBy == ''
        )
        || isStudentQuizSubmission();
      allow update: if ownsClass(request.resource.data.classId)
        || (
          isStudentImageSubmission()
          && resource.data.score == null
          && request.resource.data.activityId == resource.data.activityId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['attachments', 'status', 'submittedAt', 'updatedAt'])
        )
        || isMissingQuizSubmissionTransition();
      allow delete: if ownsClass(resource.data.classId);
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isTeacher()
        && request.resource.data.postedBy == request.auth.uid
        && (
          request.resource.data.classId == null
          || ownsClass(request.resource.data.classId)
        );
      allow update: if isTeacher()
        && resource.data.postedBy == request.auth.uid
        && (
          request.resource.data.classId == null
          || ownsClass(request.resource.data.classId)
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'message', 'announcementType', 'targetRole', 'classId', 'featured', 'updatedAt']);
      allow delete: if isTeacher()
        && resource.data.postedBy == request.auth.uid;
    }

    match /feedPosts/{postId} {
      allow read: if isStudent() || isTeacher();
      allow write: if false;

      match /likes/{studentUserId} {
        allow read: if isStudent() || isTeacher();
        allow write: if false;
      }

      match /comments/{studentUserId} {
        allow read: if isStudent() || isTeacher();
        allow write: if false;
      }
    }
  }
}
